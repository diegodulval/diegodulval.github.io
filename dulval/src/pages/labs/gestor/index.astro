---
import Layout from '../../../layouts/Layout.astro';
import logoRaw from '../../../assets/dd-logo.svg?raw';
---

<Layout
  title="Gestor de Projetos — labs.dulval"
  description="Painel pessoal para trackear, repriorizar e distribuir foco igualmente entre projetos paralelos."
>

<style is:global>
  body { padding-top: 0; }
  :root { --accent: #a78bfa; }
</style>

<!-- NAV -->
<nav class="portal-nav">
  <div class="container portal-nav-inner">
    <a href="/" class="portal-logo" set:html={logoRaw} />
    <span class="portal-nav-name">labs.dulval / gestor</span>
    <a href="/labs" class="portal-nav-back">← labs</a>
  </div>
</nav>

<!-- HERO -->
<section class="labs-hero">
  <div class="container">
    <span class="eyebrow" style="color: var(--accent);">Foco · Rotina · Repriorização</span>
    <h1 class="labs-hero-title">Gestor de<br>projetos paralelos.</h1>
    <p class="labs-hero-body">
      Painel pessoal para trackear progresso, distribuir blocos de foco e repriorizar semanalmente
      entre projetos ativos — sem deixar nenhum cair no esquecimento.
    </p>
  </div>
</section>

<!-- APP -->
<section class="section app-section">
  <div class="container">
    <div class="app-shell">

      <!-- TABS -->
      <div class="tab-bar" role="tablist">
        <button class="tab active" role="tab" aria-selected="true"  data-tab="projetos"   onclick="switchTab('projetos')">Projetos</button>
        <button class="tab"        role="tab" aria-selected="false" data-tab="rotina"     onclick="switchTab('rotina')">Rotina</button>
        <button class="tab"        role="tab" aria-selected="false" data-tab="hoje"       onclick="switchTab('hoje')">Hoje</button>
        <button class="tab"        role="tab" aria-selected="false" data-tab="estrategia" onclick="switchTab('estrategia')">Estratégia</button>
      </div>

      <!-- VIEW: PROJETOS -->
      <div id="v-projetos" class="view active">
        <div class="metrics-row">
          <div class="metric"><div class="metric-val" id="m-total">0</div><div class="metric-label">projetos ativos</div></div>
          <div class="metric"><div class="metric-val" id="m-alta">0</div><div class="metric-label">prioridade alta</div></div>
          <div class="metric"><div class="metric-val" id="m-tasks">0</div><div class="metric-label">tarefas pendentes</div></div>
        </div>

        <div class="sub-label">seus projetos</div>
        <div id="proj-list"></div>

        <div id="add-form" style="display:none" class="form-card">
          <div class="form-row">
            <input id="f-nome" class="field" placeholder="Nome do projeto" />
            <select id="f-prio" class="field">
              <option value="alta">Alta prioridade</option>
              <option value="media" selected>Média</option>
              <option value="baixa">Baixa</option>
              <option value="pausada">Pausada</option>
            </select>
            <input id="f-prog" class="field" type="number" min="0" max="100" placeholder="% concluído" style="width:130px" />
          </div>
          <div class="form-actions">
            <button class="btn btn-primary" style="background:var(--accent)" onclick="addProject()">salvar</button>
            <button class="btn btn-ghost" onclick="document.getElementById('add-form').style.display='none'">cancelar</button>
          </div>
        </div>

        <button class="add-btn" id="add-trigger" onclick="showAddForm()">+ adicionar projeto</button>
      </div>

      <!-- VIEW: ROTINA -->
      <div id="v-rotina" class="view">
        <p class="view-intro">Distribuição semanal gerada automaticamente. Cada bloco = 1h30 de foco. Alta prioridade recebe 2× mais blocos. Sexta é reservada para revisão.</p>
        <div class="rotina-legend">
          <span class="leg-item leg-alta">Alta</span>
          <span class="leg-item leg-media">Média</span>
          <span class="leg-item leg-baixa">Baixa</span>
          <span class="leg-item leg-revisao">Revisão</span>
        </div>
        <div id="rotina-grid"></div>
        <p class="view-note">Projetos pausados não recebem blocos. Sexta à tarde é sempre reservada para repriorização semanal.</p>
      </div>

      <!-- VIEW: HOJE -->
      <div id="v-hoje" class="view">
        <div class="sub-label">tarefas do dia</div>
        <div id="tasks-list"></div>
        <div class="form-card" style="margin-top:var(--sp-2)">
          <div class="form-row">
            <input id="t-nome" class="field" placeholder="Nova tarefa..." style="flex:2" />
            <select id="t-proj" class="field">
              <option value="">Projeto...</option>
            </select>
            <button class="btn btn-primary" style="background:var(--accent);white-space:nowrap" onclick="addTask()">+ add</button>
          </div>
        </div>
        <p class="view-note" style="margin-top:var(--sp-3)">Dica: limite 2–3 tarefas por projeto por dia. Consistência > velocidade.</p>
      </div>

      <!-- VIEW: ESTRATÉGIA -->
      <div id="v-estrategia" class="view">
        <div class="strategy-list">
          <div class="strategy-item" style="border-left-color:#a78bfa">
            <h3 class="strategy-title">Time-boxing — blocos de foco</h3>
            <p class="strategy-body">Nunca trabalhe em projetos de forma fragmentada. Reserve blocos de 1h30 por projeto com 15min de intervalo. Isso elimina a troca de contexto e aumenta a qualidade de entrega.</p>
          </div>
          <div class="strategy-item" style="border-left-color:#22c55e">
            <h3 class="strategy-title">Revisão semanal — toda sexta</h3>
            <p class="strategy-body">30 minutos toda sexta: revise o progresso de cada projeto, redistribua os blocos da semana seguinte conforme prioridade atual e anote o próximo passo de cada um.</p>
          </div>
          <div class="strategy-item" style="border-left-color:#f97316">
            <h3 class="strategy-title">Regra de repriorização</h3>
            <p class="strategy-body">Se um projeto não avançou por 2 semanas seguidas, muda para "pausado" e o slot é redistribuído. Isso evita projetos-zumbi que consomem energia sem progredir.</p>
          </div>
          <div class="strategy-item" style="border-left-color:#3b82f6">
            <h3 class="strategy-title">Log de sessão — 2 linhas</h3>
            <p class="strategy-body">Ao final de cada bloco, escreva: o que foi feito e qual é o próximo passo. Isso elimina o tempo perdido tentando lembrar "onde eu parei" na próxima sessão.</p>
          </div>
          <div class="strategy-item" style="border-left-color:#eab308">
            <h3 class="strategy-title">Limite de projetos ativos</h3>
            <p class="strategy-body">No máximo 4 projetos ativos simultaneamente. Os demais ficam em fila de espera. Quando um projeto é concluído ou pausado, o próximo da fila entra. Foco é escasso — trate como recurso.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="footer">
  <div class="container footer-inner">
    <a href="/" class="footer-logo" aria-label="Início" set:html={logoRaw} />
    <p class="footer-copy">labs.dulval.com &nbsp;·&nbsp; © dulval 2026</p>
    <a href="/labs" class="footer-back">← labs</a>
  </div>
</footer>

</Layout>

<script is:inline>
// ── State ──────────────────────────────────────────────────────
const STORAGE_KEY = 'dulval-gestor-v1';

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) return JSON.parse(raw);
  } catch {}
  return {
    projects: [
      { id: 1, nome: 'DiMata', prio: 'alta',   prog: 70 },
      { id: 2, nome: 'PriMata', prio: 'media',  prog: 40 },
      { id: 3, nome: 'Conecta Agent', prio: 'alta', prog: 85 },
      { id: 4, nome: 'Dulval OS', prio: 'baixa', prog: 20 },
    ],
    tasks: [],
    nextId: 10,
  };
}

function saveState() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch {}
}

let state = loadState();

// ── Helpers ────────────────────────────────────────────────────
const PRIO_LABEL  = { alta: 'Alta', media: 'Média', baixa: 'Baixa', pausada: 'Pausada' };
const PRIO_COLOR  = { alta: '#f97316', media: '#eab308', baixa: '#22c55e', pausada: '#72726f' };
const PRIO_BG     = { alta: '#fff7ed', media: '#fefce8', baixa: '#f0fdf4', pausada: '#f7f7f5' };
const PRIO_WEIGHT = { alta: 3, media: 2, baixa: 1, pausada: 0 };
const DIAS        = ['Seg', 'Ter', 'Qua', 'Qui', 'Sex'];

// ── Tabs ───────────────────────────────────────────────────────
function switchTab(t) {
  document.querySelectorAll('.tab').forEach(b => {
    b.classList.toggle('active', b.dataset.tab === t);
    b.setAttribute('aria-selected', b.dataset.tab === t ? 'true' : 'false');
  });
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById('v-' + t).classList.add('active');
  if (t === 'rotina') renderRotina();
  if (t === 'hoje')   { renderTasks(); updateTaskSelect(); }
}
window.switchTab = switchTab;

// ── Projects ───────────────────────────────────────────────────
function renderProjects() {
  const list = document.getElementById('proj-list');
  list.innerHTML = '';

  if (state.projects.length === 0) {
    list.innerHTML = '<p class="empty-msg">Nenhum projeto ainda. Adicione abaixo.</p>';
  }

  state.projects.forEach(p => {
    const color = PRIO_COLOR[p.prio];
    const bg    = PRIO_BG[p.prio];
    const div   = document.createElement('div');
    div.className = 'proj-card';
    div.innerHTML = `
      <div class="proj-top">
        <div>
          <div class="proj-nome">${p.nome}</div>
          <span class="proj-badge" style="background:${bg};color:${color}">${PRIO_LABEL[p.prio]}</span>
        </div>
        <button class="del-btn" onclick="deleteProject(${p.id})" aria-label="Remover">✕</button>
      </div>
      <div class="proj-prog-wrap">
        <div class="proj-prog-track">
          <div class="proj-prog-fill" style="width:${p.prog}%;background:${color}"></div>
        </div>
        <span class="proj-pct" style="color:${color}">${p.prog}%</span>
      </div>
    `;
    list.appendChild(div);
  });

  updateMetrics();
}

function updateMetrics() {
  const ativos = state.projects.filter(p => p.prio !== 'pausada');
  document.getElementById('m-total').textContent = ativos.length;
  document.getElementById('m-alta').textContent  = state.projects.filter(p => p.prio === 'alta').length;
  document.getElementById('m-tasks').textContent = state.tasks.filter(t => !t.done).length;
}

function showAddForm() {
  document.getElementById('add-form').style.display = 'block';
  document.getElementById('add-trigger').style.display = 'none';
  document.getElementById('f-nome').focus();
}
window.showAddForm = showAddForm;

function addProject() {
  const nome = document.getElementById('f-nome').value.trim();
  const prio = document.getElementById('f-prio').value;
  const prog = Math.min(100, Math.max(0, parseInt(document.getElementById('f-prog').value) || 0));
  if (!nome) return;
  state.projects.push({ id: state.nextId++, nome, prio, prog });
  saveState();
  document.getElementById('add-form').style.display = 'none';
  document.getElementById('add-trigger').style.display = 'block';
  document.getElementById('f-nome').value = '';
  document.getElementById('f-prog').value = '';
  renderProjects();
}
window.addProject = addProject;

function deleteProject(id) {
  state.projects = state.projects.filter(p => p.id !== id);
  saveState();
  renderProjects();
}
window.deleteProject = deleteProject;

// ── Rotina ─────────────────────────────────────────────────────
function renderRotina() {
  const grid  = document.getElementById('rotina-grid');
  const ativos = state.projects
    .filter(p => p.prio !== 'pausada')
    .sort((a, b) => PRIO_WEIGHT[b.prio] - PRIO_WEIGHT[a.prio]);

  if (!ativos.length) {
    grid.innerHTML = '<p class="empty-msg">Adicione projetos ativos para gerar a rotina.</p>';
    return;
  }

  const pool = [];
  ativos.forEach(p => { for (let i = 0; i < PRIO_WEIGHT[p.prio]; i++) pool.push(p); });

  let html = '<div class="rotina-table">';
  DIAS.forEach((dia, di) => {
    html += `<div class="rotina-row"><div class="rotina-dia">${dia}</div>`;
    for (let s = 0; s < 3; s++) {
      const isSex = dia === 'Sex';
      if (isSex && s === 2) {
        html += `<div class="rotina-slot slot-revisao">Revisão semanal</div>`;
      } else if (isSex && s === 1) {
        html += `<div class="rotina-slot slot-buffer">buffer</div>`;
      } else {
        const p     = pool[(di * 3 + s) % pool.length];
        const color = PRIO_COLOR[p.prio];
        const bg    = PRIO_BG[p.prio];
        html += `<div class="rotina-slot" style="background:${bg};color:${color};border-color:${color}22">${p.nome}</div>`;
      }
    }
    html += '</div>';
  });
  html += '</div>';
  grid.innerHTML = html;
}

// ── Tasks ──────────────────────────────────────────────────────
function renderTasks() {
  const list = document.getElementById('tasks-list');
  list.innerHTML = '';

  if (!state.tasks.length) {
    list.innerHTML = '<p class="empty-msg">Nenhuma tarefa ainda.</p>';
    updateMetrics();
    return;
  }

  state.tasks.forEach((t, i) => {
    const proj = state.projects.find(p => p.id === t.projId);
    const row  = document.createElement('div');
    row.className = 'task-row' + (t.done ? ' task-done' : '');
    row.innerHTML = `
      <input type="checkbox" ${t.done ? 'checked' : ''} onchange="toggleTask(${i})" />
      <span class="task-label">${t.nome}</span>
      ${proj ? `<span class="task-proj">${proj.nome}</span>` : ''}
      <button class="del-btn" style="margin-left:auto" onclick="deleteTask(${i})" aria-label="Remover">✕</button>
    `;
    list.appendChild(row);
  });
  updateMetrics();
}

function toggleTask(i) {
  state.tasks[i].done = !state.tasks[i].done;
  saveState();
  renderTasks();
}
window.toggleTask = toggleTask;

function deleteTask(i) {
  state.tasks.splice(i, 1);
  saveState();
  renderTasks();
}
window.deleteTask = deleteTask;

function updateTaskSelect() {
  const sel = document.getElementById('t-proj');
  sel.innerHTML = '<option value="">Projeto...</option>';
  state.projects.forEach(p => {
    const opt = document.createElement('option');
    opt.value = p.id;
    opt.textContent = p.nome;
    sel.appendChild(opt);
  });
}

function addTask() {
  const nome   = document.getElementById('t-nome').value.trim();
  const projId = parseInt(document.getElementById('t-proj').value) || null;
  if (!nome) return;
  state.tasks.push({ nome, projId, done: false });
  saveState();
  document.getElementById('t-nome').value = '';
  renderTasks();
}
window.addTask = addTask;

// ── Init ───────────────────────────────────────────────────────
renderProjects();
</script>

<style>
/* ── Nav (mesmo padrão do labs) ── */
.portal-nav { height: 64px; border-bottom: 1px solid var(--border); display: flex; align-items: center; }
.portal-nav-inner { display: flex; align-items: center; gap: var(--sp-3); }
.portal-logo { display: flex; align-items: center; line-height: 0; }
.portal-logo :global(svg) { width: 22px; height: auto; }
.portal-logo :global(svg path) { fill: var(--text-primary); stroke: none; }
.portal-nav-name { font-size: var(--fs-sm); font-weight: 600; }
.portal-nav-back { margin-left: auto; font-size: var(--fs-sm); color: var(--text-muted); transition: color 0.15s; }
.portal-nav-back:hover { color: var(--text-primary); }

/* ── Hero ── */
.labs-hero { padding: var(--sp-7) 0 var(--sp-6); border-bottom: 1px solid var(--border); }
.labs-hero-title { font-size: var(--fs-hero); font-weight: 700; letter-spacing: -0.028em; line-height: 1.06; margin: var(--sp-3) 0 var(--sp-4); max-width: 560px; }
.labs-hero-body { font-size: var(--fs-lg); color: var(--text-secondary); max-width: 500px; line-height: 1.65; }

/* ── App shell ── */
.app-section { border-bottom: none; }
.app-shell { max-width: 720px; }

/* ── Tabs ── */
.tab-bar { display: flex; gap: 2px; background: var(--surface-dim); border-radius: var(--radius-md); padding: 4px; margin-bottom: var(--sp-4); border: 1px solid var(--border); }
.tab { flex: 1; text-align: center; padding: 8px; font-size: var(--fs-sm); font-weight: 500; border-radius: 9px; cursor: pointer; border: none; background: none; color: var(--text-muted); font-family: 'DM Sans', sans-serif; transition: all 0.15s; }
.tab.active { background: var(--surface); color: var(--text-primary); border: 1px solid var(--border); }
.tab:not(.active):hover { color: var(--text-secondary); }

/* ── Views ── */
.view { display: none; }
.view.active { display: block; }
.view-intro { font-size: var(--fs-sm); color: var(--text-secondary); margin-bottom: var(--sp-3); line-height: 1.65; }
.view-note { font-size: var(--fs-xs); color: var(--text-muted); margin-top: var(--sp-2); }
.sub-label { font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--sp-2); }
.empty-msg { font-size: var(--fs-sm); color: var(--text-muted); padding: var(--sp-2) 0; }

/* ── Metrics ── */
.metrics-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-1); margin-bottom: var(--sp-4); }
.metric { background: var(--surface-dim); border-radius: var(--radius-md); padding: var(--sp-2) var(--sp-3); border: 1px solid var(--border); }
.metric-val { font-size: 28px; font-weight: 700; letter-spacing: -0.02em; }
.metric-label { font-size: var(--fs-xs); color: var(--text-muted); margin-top: 2px; }

/* ── Project cards ── */
.proj-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--sp-3); margin-bottom: 1px; }
.proj-card:last-child { margin-bottom: var(--sp-2); }
.proj-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: var(--sp-2); }
.proj-nome { font-size: var(--fs-md); font-weight: 600; letter-spacing: -0.015em; margin-bottom: 4px; }
.proj-badge { display: inline-block; font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 10px; border-radius: var(--radius-pill); }
.proj-prog-wrap { display: flex; align-items: center; gap: var(--sp-2); }
.proj-prog-track { flex: 1; height: 3px; background: var(--border); border-radius: 2px; overflow: hidden; }
.proj-prog-fill { height: 100%; border-radius: 2px; transition: width 0.4s ease; }
.proj-pct { font-size: var(--fs-xs); font-weight: 600; min-width: 32px; text-align: right; }
.del-btn { background: none; border: none; cursor: pointer; color: var(--text-muted); font-size: 12px; padding: 4px 6px; border-radius: 4px; transition: color 0.15s; line-height: 1; }
.del-btn:hover { color: var(--text-primary); }

/* ── Add form ── */
.form-card { background: var(--surface-dim); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--sp-3); margin-bottom: var(--sp-2); }
.form-row { display: flex; gap: var(--sp-1); flex-wrap: wrap; align-items: center; margin-bottom: var(--sp-2); }
.form-actions { display: flex; gap: var(--sp-1); }
.field { font-family: 'DM Sans', sans-serif; font-size: var(--fs-sm); padding: 9px 14px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--text-primary); flex: 1; min-width: 120px; transition: border-color 0.15s; }
.field:focus { outline: none; border-color: var(--accent); }
.add-btn { width: 100%; padding: var(--sp-2); background: none; border: 1px dashed var(--border); border-radius: var(--radius-md); color: var(--text-muted); font-size: var(--fs-sm); font-family: 'DM Sans', sans-serif; cursor: pointer; transition: all 0.15s; margin-top: var(--sp-1); }
.add-btn:hover { border-color: var(--accent); color: var(--accent); background: var(--surface-dim); }

/* ── Rotina ── */
.rotina-legend { display: flex; gap: var(--sp-2); margin-bottom: var(--sp-3); flex-wrap: wrap; }
.leg-item { font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 10px; border-radius: var(--radius-pill); }
.leg-alta    { background: #fff7ed; color: #f97316; }
.leg-media   { background: #fefce8; color: #eab308; }
.leg-baixa   { background: #f0fdf4; color: #22c55e; }
.leg-revisao { background: #f5f3ff; color: #a78bfa; }

.rotina-table { display: flex; flex-direction: column; gap: 1px; background: var(--border); border-radius: var(--radius-md); overflow: hidden; }
.rotina-row { display: grid; grid-template-columns: 44px 1fr 1fr 1fr; gap: 1px; background: var(--border); }
.rotina-dia { background: var(--surface-dim); display: flex; align-items: center; justify-content: center; font-size: var(--fs-xs); font-weight: 600; color: var(--text-muted); padding: var(--sp-2) var(--sp-1); }
.rotina-slot { background: var(--surface); display: flex; align-items: center; justify-content: center; font-size: var(--fs-xs); font-weight: 600; text-align: center; padding: var(--sp-2); min-height: 52px; border: 1px solid transparent; }
.slot-revisao { background: #f5f3ff !important; color: #a78bfa !important; }
.slot-buffer  { background: var(--surface-dim) !important; color: var(--text-muted) !important; font-style: italic; }

/* ── Tasks ── */
.task-row { display: flex; align-items: center; gap: var(--sp-1); padding: var(--sp-1) 0; border-bottom: 1px solid var(--border); }
.task-row:last-child { border-bottom: none; }
.task-row input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--accent); cursor: pointer; flex-shrink: 0; }
.task-label { font-size: var(--fs-sm); flex: 1; }
.task-proj { font-size: var(--fs-xs); color: var(--text-muted); white-space: nowrap; }
.task-done .task-label { text-decoration: line-through; color: var(--text-muted); }

/* ── Strategy ── */
.strategy-list { display: flex; flex-direction: column; gap: 1px; background: var(--border); border-radius: var(--radius-md); overflow: hidden; }
.strategy-item { background: var(--surface); padding: var(--sp-3) var(--sp-4); border-left: 3px solid; }
.strategy-title { font-size: var(--fs-md); font-weight: 600; letter-spacing: -0.01em; margin-bottom: var(--sp-1); }
.strategy-body { font-size: var(--fs-sm); color: var(--text-secondary); line-height: 1.7; }

/* ── Footer ── */
