/* ══ Add project form ════════════════════════════════════════════ */
.add-project-form {
  border: 1px solid var(--border); border-radius: 12px;
  padding: 20px 24px; margin-bottom: 12px; background: var(--surface-dim);
}
.add-form-fields { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
.add-form-actions { display: flex; gap: 8px; }
.field {
  font-family: 'DM Sans', sans-serif; font-size: 14px;
  padding: 9px 14px; border: 1px solid var(--border);
  border-radius: 8px; background: var(--surface);
  color: var(--text-primary); flex: 1; min-width: 120px;
  transition: border-color 0.15s;
}
.field-sm { flex: 0 0 auto; min-width: 0; width: auto; }
.field:focus { outline: none; border-color: var(--accent); }
.add-proj-btn {
  width: 100%; padding: 12px;
  background: none; border: 1px dashed var(--border);
  border-radius: 12px; color: var(--text-muted);
  font-size: 14px; font-family: 'DM Sans', sans-serif;
  cursor: pointer; transition: border-color 0.15s, color 0.15s;
}
.add-proj-btn:hover { border-color: var(--accent); color: var(--accent); }

/* ══ Rotina ══════════════════════════════════════════════════════ */
.rotina-legend { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
.leg {
  font-size: 11px; font-weight: 600; letter-spacing: 0.06em;
  text-transform: uppercase; padding: 3px 10px; border-radius: 100px;
}
.leg.alta    { background: #fff7ed; color: #f97316; }
.leg.media   { background: #fffbeb; color: #f59e0b; }
.leg.baixa   { background: #f0fdf4; color: #22c55e; }
.leg.revisao { background: #f5f3ff; color: #a78bfa; }

.rotina-table { display: flex; flex-direction: column; gap: 1px; background: var(--border); border-radius: 12px; overflow: hidden; }
.rotina-row { display: grid; grid-template-columns: 44px 1fr 1fr 1fr; gap: 1px; background: var(--border); }
.rotina-dia { background: var(--surface-dim); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; color: var(--text-muted); }
.rotina-slot { background: var(--surface); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; text-align: center; padding: 14px 8px; min-height: 52px; }
.r-revisao { background: #f5f3ff !important; color: #a78bfa !important; }
.r-buffer  { background: var(--surface-dim) !important; color: var(--text-muted) !important; font-style: italic; }

/* ══ Strategy ════════════════════════════════════════════════════ */
.strategy-list { display: flex; flex-direction: column; gap: 1px; background: var(--border); border-radius: 12px; overflow: hidden; }
.strategy-item {
  background: var(--surface); padding: 24px 32px;
  border-left: 3px solid var(--s-color, var(--border));
}
.strategy-title { font-size: 17px; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 8px; }
.strategy-body { font-size: 14px; color: var(--text-secondary); line-height: 1.7; }

/* ══ Footer ══════════════════════════════════════════════════════ */
.footer { border-top: 1px solid var(--border); padding: 24px 0; }
.footer-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
.footer-logo { display: flex; justify-self: start; }
.footer-logo svg { width: 20px; height: auto; }
.footer-logo svg path { fill: var(--text-primary); stroke: none; }
.footer-copy { font-size: 12px; color: var(--text-muted); text-align: center; }
.footer-back { justify-self: end; font-size: 14px; color: var(--text-muted); transition: color 0.15s; }
.footer-back:hover { color: var(--text-primary); }

/* ══ Responsive ══════════════════════════════════════════════════ */
@media (max-width: 600px) {
  .metrics-row { flex-wrap: wrap; }
  .metric { min-width: 50%; }
  .metric:nth-child(2) { border-right: none; }
  .signal-board { flex-direction: column; }
  .signal-divider { width: auto; height: 1px; }
  .add-form-fields { flex-direction: column; }
  .rotina-row { grid-template-columns: 32px 1fr 1fr 1fr; }
  .task-add { flex-wrap: wrap; }
  .task-input { min-width: 0; }
  .task-date { width: 100%; }
}

/* ══ Dark mode ═══════════════════════════════════════════════════ */
@media (prefers-color-scheme: dark) {
  .leg.alta    { background: #431407; color: #fb923c; }
  .leg.media   { background: #422006; color: #facc15; }
  .leg.baixa   { background: #052e16; color: #4ade80; }
  .leg.revisao { background: #2e1065; color: #c4b5fd; }
  .r-revisao   { background: #2e1065 !important; color: #c4b5fd !important; }
}
</style>
