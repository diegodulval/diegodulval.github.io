---
import Layout from '../../../layouts/Layout.astro';
import logoRaw from '../../../assets/dd-logo.svg?raw';
---

<Layout
  title="Gestor de Projetos — labs.dulval"
  description="Painel pessoal para trackear, repriorizar e distribuir foco igualmente entre projetos paralelos."
>

<style is:global>
  body { padding-top: 0; }
  :root { --accent: #a78bfa; }
</style>

<!-- LOGIN GATE -->
<div id="login-gate">
  <div class="login-card">
    <div class="login-logo" set:html={logoRaw} />
    <p class="login-label">labs.dulval / gestor</p>
    <form id="login-form" autocomplete="off">
      <input id="l-user" class="login-field" type="text" placeholder="usuário" autocomplete="off" />
      <input id="l-pass" class="login-field" type="password" placeholder="senha" autocomplete="off" />
      <p id="login-error" class="login-error" style="display:none">credenciais inválidas</p>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:4px">entrar →</button>
    </form>
  </div>
</div>

<!-- NAV -->
<nav class="portal-nav">
  <div class="container portal-nav-inner">
    <a href="/" class="portal-logo" set:html={logoRaw} />
    <span class="portal-nav-name">labs.dulval / gestor</span>
    <a href="/labs" class="portal-nav-back">← labs</a>
  </div>
</nav>

<!-- HERO -->
<section class="labs-hero">
  <div class="container">
    <span class="eyebrow" style="color:var(--accent)">Foco · Rotina · Repriorização</span>
    <h1 class="labs-hero-title">Gestor de<br>projetos paralelos.</h1>
    <p class="labs-hero-body">
      Painel pessoal para trackear progresso, distribuir blocos de foco e repriorizar semanalmente
      entre projetos ativos — sem deixar nenhum cair no esquecimento.
    </p>
  </div>
</section>

<!-- APP -->
<section class="app-section">
  <div class="container">
    <div class="app-shell">

      <!-- TABS -->
      <div class="tab-bar" role="tablist">
        <button class="tab active" role="tab" data-tab="projetos"   onclick="switchTab('projetos')">Projetos</button>
        <button class="tab"        role="tab" data-tab="rotina"     onclick="switchTab('rotina')">Rotina</button>
        <button class="tab"        role="tab" data-tab="hoje"       onclick="switchTab('hoje')">Hoje</button>
        <button class="tab"        role="tab" data-tab="estrategia" onclick="switchTab('estrategia')">Estratégia</button>
      </div>

      <!-- VIEW: PROJETOS -->
      <div id="v-projetos" class="view active">

        <div class="metrics-row">
          <div class="metric">
            <div class="metric-val" id="m-total">0</div>
            <div class="metric-label">projetos ativos</div>
          </div>
          <div class="metric">
            <div class="metric-val" id="m-alta">0</div>
            <div class="metric-label">prioridade alta</div>
          </div>
          <div class="metric">
            <div class="metric-val" id="m-tasks">0</div>
            <div class="metric-label">tarefas abertas</div>
          </div>
        </div>

        <div id="tasks-summary"></div>

        <p class="section-eyebrow">Projetos</p>
        <div id="proj-list"></div>

        <div id="add-form" style="display:none" class="add-project-form">
          <div class="add-form-fields">
            <input id="f-nome" class="field" placeholder="Nome do projeto" />
            <select id="f-prio" class="field field-sm">
              <option value="alta">Alta</option>
              <option value="media" selected>Média</option>
              <option value="baixa">Baixa</option>
              <option value="pausada">Pausada</option>
            </select>
            <input id="f-prog" class="field field-sm" type="number" min="0" max="100" placeholder="%" />
          </div>
          <div class="add-form-actions">
            <button class="btn btn-primary" onclick="addProject()">salvar</button>
            <button class="btn btn-ghost" onclick="document.getElementById('add-form').style.display='none'">cancelar</button>
          </div>
        </div>

        <button class="add-proj-btn" id="add-trigger" onclick="showAddForm()">+ adicionar projeto</button>
      </div>

      <!-- VIEW: ROTINA -->
      <div id="v-rotina" class="view">
        <p class="view-intro">Distribuição semanal automática por peso de prioridade. Cada bloco = 1h30 de foco. Sexta reservada para revisão.</p>
        <div class="rotina-legend">
          <span class="leg alta">Alta</span>
          <span class="leg media">Média</span>
          <span class="leg baixa">Baixa</span>
          <span class="leg revisao">Revisão</span>
        </div>
        <div id="rotina-grid"></div>
        <p class="view-note">Projetos pausados não recebem blocos. Sexta à tarde é reservada para repriorização semanal.</p>
      </div>

      <!-- VIEW: HOJE -->
      <div id="v-hoje" class="view">
        <p class="view-intro">Todas as tarefas abertas ordenadas por urgência. Clique no status para avançar.</p>
        <div id="hoje-list"></div>
        <p class="view-note">Tarefas são adicionadas dentro de cada projeto, na aba Projetos.</p>
      </div>

      <!-- VIEW: ESTRATÉGIA -->
      <div id="v-estrategia" class="view">
        <div class="strategy-list">
          <div class="strategy-item" style="--s-color:#a78bfa">
            <h3 class="strategy-title">Time-boxing — blocos de foco</h3>
            <p class="strategy-body">Nunca trabalhe em projetos de forma fragmentada. Reserve blocos de 1h30 por projeto com 15min de intervalo. Isso elimina a troca de contexto e aumenta a qualidade de entrega.</p>
          </div>
          <div class="strategy-item" style="--s-color:#22c55e">
            <h3 class="strategy-title">Revisão semanal — toda sexta</h3>
            <p class="strategy-body">30 minutos toda sexta: revise o progresso de cada projeto, redistribua os blocos da semana seguinte conforme prioridade atual e anote o próximo passo de cada um.</p>
          </div>
          <div class="strategy-item" style="--s-color:#f97316">
            <h3 class="strategy-title">Regra de repriorização</h3>
            <p class="strategy-body">Se um projeto não avançou por 2 semanas seguidas, muda para "pausado" e o slot é redistribuído. Isso evita projetos-zumbi que consomem energia sem progredir.</p>
          </div>
          <div class="strategy-item" style="--s-color:#3b82f6">
            <h3 class="strategy-title">Log de sessão — 2 linhas</h3>
            <p class="strategy-body">Ao final de cada bloco: o que foi feito e qual é o próximo passo. Isso elimina o tempo perdido tentando lembrar "onde eu parei" na próxima sessão.</p>
          </div>
          <div class="strategy-item" style="--s-color:#eab308">
            <h3 class="strategy-title">Limite de projetos ativos</h3>
            <p class="strategy-body">No máximo 4 projetos ativos simultaneamente. Os demais ficam em fila. Quando um projeto é concluído ou pausado, o próximo da fila entra. Foco é escasso — trate como recurso.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <a href="/" class="footer-logo" aria-label="Início" set:html={logoRaw} />
    <p class="footer-copy">labs.dulval.com &nbsp;·&nbsp; © dulval 2026</p>
    <a href="/labs" class="footer-back">← labs</a>
  </div>
</footer>

</Layout>

<script is:inline>
// ── Auth ────────────────────────────────────────────────────────
(function () {
  const SESSION_KEY = 'dulval-gestor-auth';
  const CREDS = { user: 'dulval', pass: '@labs2026' };
  const gate  = document.getElementById('login-gate');
  const form  = document.getElementById('login-form');
  const err   = document.getElementById('login-error');

  function unlock() {
    gate.style.opacity = '0';
    gate.style.pointerEvents = 'none';
    setTimeout(() => gate.remove(), 280);
  }
  if (sessionStorage.getItem(SESSION_KEY) === '1') unlock();

  form.addEventListener('submit', e => {
    e.preventDefault();
    const u = document.getElementById('l-user').value.trim();
    const p = document.getElementById('l-pass').value;
    if (u === CREDS.user && p === CREDS.pass) {
      sessionStorage.setItem(SESSION_KEY, '1');
      unlock();
    } else {
      err.style.display = 'block';
      document.getElementById('l-pass').value = '';
      document.getElementById('l-pass').focus();
    }
  });
}());

// ── Constants ───────────────────────────────────────────────────
const STORAGE_KEY = 'dulval-gestor-v5';

const PRIO_LABEL  = { alta: 'Alta', media: 'Média', baixa: 'Baixa', pausada: 'Pausada' };
const PRIO_COLOR  = { alta: '#f97316', media: '#f59e0b', baixa: '#22c55e', pausada: '#9ca3af' };
const PRIO_BG     = { alta: '#fff7ed', media: '#fffbeb', baixa: '#f0fdf4', pausada: '#f9fafb' };
const PRIO_WEIGHT = { alta: 3, media: 2, baixa: 1, pausada: 0 };

const TASK_NEXT  = { pendente: 'fazendo', fazendo: 'feita', feita: 'pendente' };
const TASK_ICON  = { pendente: '○', fazendo: '◑', feita: '●' };
const TASK_TITLE = {
  pendente: 'Pendente — clique para iniciar',
