}

// ── State load / save ───────────────────────────────────────────
function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) return JSON.parse(raw);
    // Migrate from v4 — add deadline field to tasks
    const v4raw = localStorage.getItem('dulval-gestor-v4');
    if (v4raw) {
      const v4 = JSON.parse(v4raw);
      const projects = (v4.projects || []).map(p => ({
        ...p,
        tasks: (p.tasks || []).map(t => ({ deadline: null, ...t })),
      }));
      const migrated = { ...v4, version: 5, projects };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(migrated));
      return migrated;
    }
  } catch {}
  return defaultState();
}

function saveState() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch {}
}

let state = loadState();

// ── Tabs ────────────────────────────────────────────────────────
function switchTab(t) {
  document.querySelectorAll('.tab').forEach(b => {
    b.classList.toggle('active', b.dataset.tab === t);
    b.setAttribute('aria-selected', b.dataset.tab === t ? 'true' : 'false');
  });
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById('v-' + t).classList.add('active');
  if (t === 'rotina') renderRotina();
  if (t === 'hoje')   renderHoje();
}
window.switchTab = switchTab;

// ── Metrics ─────────────────────────────────────────────────────
function updateMetrics() {
  const allTasks = state.projects.flatMap(p => p.tasks || []);
  const abertas  = allTasks.filter(t => t.status !== 'feita');
  document.getElementById('m-total').textContent = state.projects.filter(p => p.prio !== 'pausada').length;
  document.getElementById('m-alta').textContent  = state.projects.filter(p => p.prio === 'alta').length;
  document.getElementById('m-tasks').textContent = abertas.length;
}

// ── Deadline helper ──────────────────────────────────────────────
function deadlineLabel(deadline) {
  if (!deadline) return null;
  const today = new Date(); today.setHours(0, 0, 0, 0);
  const due   = new Date(deadline + 'T00:00:00');
  const diff  = Math.round((due - today) / 86400000);
  if (diff < 0)   return { text: `${Math.abs(diff)}d atraso`, color: '#ef4444', weight: 700 };
  if (diff === 0) return { text: 'hoje',    color: '#f97316', weight: 700 };
  if (diff === 1) return { text: 'amanhã',  color: '#f59e0b', weight: 600 };
  if (diff <= 7)  return { text: `${diff}d`, color: '#eab308', weight: 500 };
  return { text: due.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' }), color: 'var(--text-muted)', weight: 400 };
}

// ── Signal board ─────────────────────────────────────────────────
function renderSummary() {
  const el = document.getElementById('tasks-summary');
  if (!el) return;

  const allTasks = state.projects.flatMap(p =>
    (p.tasks || []).map(t => ({ ...t, projNome: p.nome, projId: p.id, projPrio: p.prio }))
  );

  if (!allTasks.length) { el.innerHTML = ''; return; }

  const fazendo      = allTasks.filter(t => t.status === 'fazendo');
  const pendentes    = allTasks.filter(t => t.status === 'pendente');
  const altaPendente = pendentes.filter(t => t.prio === 'alta');
  const projSemTask  = state.projects.filter(p => p.prio !== 'pausada' && !(p.tasks && p.tasks.length));

  const proxima = [...pendentes]
    .filter(t => { const p = state.projects.find(x => x.id === t.projId); return p && p.prio !== 'pausada'; })
    .sort((a, b) => {
      const pd = PRIO_WEIGHT[b.prio] - PRIO_WEIGHT[a.prio];
      return pd !== 0 ? pd : PRIO_WEIGHT[b.projPrio] - PRIO_WEIGHT[a.projPrio];
    })[0];

  const today    = new Date(); today.setHours(0, 0, 0, 0);
  const overdue  = allTasks.filter(t => t.status !== 'feita' && t.deadline && new Date(t.deadline + 'T00:00:00') < today);
  const dueWeek  = allTasks.filter(t => t.status !== 'feita' && t.deadline && (() => {
    const d = new Date(t.deadline + 'T00:00:00');
    const diff = Math.round((d - today) / 86400000);
    return diff >= 0 && diff <= 7;
  })());

  const alerts = [];
  if (overdue.length)      alerts.push({ text: `${overdue.length} tarefa${overdue.length > 1 ? 's' : ''} em atraso`, urgent: true });
  if (dueWeek.length)      alerts.push({ text: `${dueWeek.length} vencendo esta semana`, urgent: false });
  if (altaPendente.length) alerts.push({ text: `${altaPendente.length} alta prioridade parada${altaPendente.length > 1 ? 's' : ''}`, urgent: false });
  if (projSemTask.length)  alerts.push({ text: `${projSemTask.length} projeto${projSemTask.length > 1 ? 's' : ''} sem tarefas`, urgent: false });
  if (fazendo.length > 3)  alerts.push({ text: `${fazendo.length} itens simultâneos — foque`, urgent: false });

  const fazendoHtml = fazendo.length
    ? fazendo.slice(0, 2).map(t => `
        <div class="signal-task">
          <span class="signal-proj-name">${t.projNome}</span>
          <span class="signal-task-title">${t.titulo}</span>
        </div>`).join('')
    : '<span class="signal-empty">nenhuma em andamento</span>';

  const proximaHtml = proxima
    ? `<div class="signal-task">
         <span class="signal-proj-name">${proxima.projNome}</span>
         <span class="signal-task-title">${proxima.titulo}</span>
       </div>`
    : '<span class="signal-empty">tudo concluído</span>';

  el.innerHTML = `
    <div class="signal-board">
      <div class="signal-col">
        <span class="signal-eyebrow">⚡ em andamento</span>
        ${fazendoHtml}
      </div>
      <div class="signal-divider"></div>
      <div class="signal-col signal-col-next">
        <span class="signal-eyebrow">💡 próxima sugerida</span>
        ${proximaHtml}
      </div>
    </div>
    ${alerts.length ? `<div class="signal-alerts">${alerts.map(a =>
      `<span class="signal-alert${a.urgent ? ' signal-alert--urgent' : ''}">⚠ ${a.text}</span>`
    ).join('')}</div>` : ''}
  `;
}

// ── Projects render ──────────────────────────────────────────────
function renderProjects() {
  const list = document.getElementById('proj-list');
  list.innerHTML = '';

  if (!state.projects.length) {
    list.innerHTML = '<p class="empty-msg">Nenhum projeto ainda. Adicione abaixo.</p>';
    updateMetrics(); renderSummary(); return;
  }

  state.projects.forEach(p => {
    const color = PRIO_COLOR[p.prio];
    const bg    = PRIO_BG[p.prio];
    const div   = document.createElement('div');
    div.className = 'proj-card';

    div.innerHTML = `
      <div class="proj-summary" onclick="toggleDetail(${p.id})">
        <div class="proj-header">
          <div class="proj-name-wrap">
            <span class="proj-nome">${p.nome}</span>
            <span class="proj-badge" style="color:${color};background:${bg}">${PRIO_LABEL[p.prio]}</span>
          </div>
          <div class="proj-actions">
            <span class="proj-chevron" id="chev-${p.id}">›</span>
            <button class="icon-btn" onclick="event.stopPropagation();deleteProject(${p.id})" aria-label="Remover">✕</button>
          </div>
        </div>
        <div class="proj-prog-row">
          <div class="prog-track">
            <div class="prog-fill" style="width:${p.prog}%;background:${color}"></div>
          </div>
          <span class="prog-pct" style="color:${color}">${p.prog}%</span>
        </div>
      </div>

      <div class="proj-detail" id="detail-${p.id}">
        ${p.escopo ? `
        <div class="detail-block">
          <span class="detail-eyebrow">Escopo</span>
          <p class="detail-body">${p.escopo}</p>
        </div>` : ''}
        <div class="detail-block detail-tasks-block">
          <div class="detail-tasks-header">
            <span class="detail-eyebrow">Tarefas</span>
            <span class="detail-count" id="tcount-${p.id}"></span>
          </div>
          <div class="task-list" id="tasks-${p.id}"></div>
          <div class="task-add">
            <input
              class="task-input"
              id="nt-${p.id}"
              placeholder="Nova tarefa..."
              onkeydown="if(event.key==='Enter')addTask(${p.id})"
            />
            <select class="task-prio" id="np-${p.id}">
              <option value="alta">Alta</option>
              <option value="media" selected>Média</option>
              <option value="baixa">Baixa</option>
            </select>
            <input type="date" class="task-date" id="nd-${p.id}" title="Deadline (opcional)" />
            <button class="task-add-btn" onclick="addTask(${p.id})">+</button>
          </div>
        </div>
      </div>
    `;
    list.appendChild(div);
    renderProjectTasks(p.id);
  });

  updateMetrics();
  renderSummary();
}

function toggleDetail(id) {
  const detail  = document.getElementById('detail-' + id);
  const chevron = document.getElementById('chev-' + id);
  if (!detail) return;
  const isOpen = detail.classList.contains('open');
  detail.classList.toggle('open', !isOpen);
  if (chevron) chevron.classList.toggle('rotated', !isOpen);
}
window.toggleDetail = toggleDetail;

// ── Project CRUD ─────────────────────────────────────────────────
function showAddForm() {
  document.getElementById('add-form').style.display = 'block';
  document.getElementById('add-trigger').style.display = 'none';
  document.getElementById('f-nome').focus();
}
window.showAddForm = showAddForm;

function addProject() {
  const nome = document.getElementById('f-nome').value.trim();
  const prio = document.getElementById('f-prio').value;
  const prog = Math.min(100, Math.max(0, parseInt(document.getElementById('f-prog').value) || 0));
  if (!nome) return;
  state.projects.push({ id: state.nextId++, nome, prio, prog, escopo: '', tasks: [] });
  saveState();
  document.getElementById('add-form').style.display = 'none';
  document.getElementById('add-trigger').style.display = 'block';
  document.getElementById('f-nome').value = '';
  document.getElementById('f-prog').value = '';
  renderProjects();
}
window.addProject = addProject;

function deleteProject(id) {
  state.projects = state.projects.filter(p => p.id !== id);
  saveState(); renderProjects();
}
window.deleteProject = deleteProject;

// ── Per-project task render ──────────────────────────────────────
function renderProjectTasks(projId) {
  const el      = document.getElementById('tasks-' + projId);
  const countEl = document.getElementById('tcount-' + projId);
  if (!el) return;

  const proj = state.projects.find(p => p.id === projId);
  if (!proj) return;

  const tasks  = proj.tasks || [];
  const abertas = tasks.filter(t => t.status !== 'feita').length;

  if (countEl) countEl.textContent = tasks.length
    ? `${abertas} aberta${abertas !== 1 ? 's' : ''} · ${tasks.length} total` : '';

  if (!tasks.length) {
    el.innerHTML = '<p class="task-empty-msg">Nenhuma tarefa ainda.</p>';
    return;
  }

  const BY_STATUS = { fazendo: 0, pendente: 1, feita: 2 };
  const BY_PRIO   = { alta: 0, media: 1, baixa: 2 };

  el.innerHTML = [...tasks]
    .sort((a, b) => {
      const sd = BY_STATUS[a.status] - BY_STATUS[b.status];
      return sd !== 0 ? sd : BY_PRIO[a.prio] - BY_PRIO[b.prio];
    })
    .map(t => {
      const iconColor = t.status === 'fazendo' ? 'var(--accent)'
                      : t.status === 'feita'   ? 'var(--text-muted)'
                      : 'var(--text-muted)';
      const dl = deadlineLabel(t.deadline);
      return `
        <div class="task-row ${t.status === 'feita' ? 'is-done' : ''} ${t.status === 'fazendo' ? 'is-active' : ''}">
          <button
            class="task-icon-btn"
            onclick="cycleTaskStatus(${projId}, ${t.id})"
            title="${TASK_TITLE[t.status]}"
            style="color:${iconColor}"
          >${TASK_ICON[t.status]}</button>
          <span class="task-text">${t.titulo}</span>
          ${dl ? `<span class="task-deadline" style="color:${dl.color};font-weight:${dl.weight}">${dl.text}</span>` : ''}
          <span class="prio-dot" style="background:${PRIO_COLOR[t.prio]}" title="${PRIO_LABEL[t.prio]}"></span>
          <button class="icon-btn" onclick="event.stopPropagation();deleteTask(${projId}, ${t.id})">✕</button>
        </div>`;
    }).join('');
}

// ── Task CRUD ────────────────────────────────────────────────────
function addTask(projId) {
  const inputEl = document.getElementById('nt-' + projId);
  const prioEl  = document.getElementById('np-' + projId);
  const dateEl  = document.getElementById('nd-' + projId);
  const titulo  = inputEl ? inputEl.value.trim() : '';
  if (!titulo) return;
  const proj = state.projects.find(p => p.id === projId);
  if (!proj) return;
  if (!proj.tasks) proj.tasks = [];
  proj.tasks.push({
    id: state.nextTaskId++, titulo,
    prio: prioEl ? prioEl.value : 'media',
    status: 'pendente',
    criadaEm: new Date().toISOString().slice(0, 10),
    deadline: dateEl && dateEl.value ? dateEl.value : null,
  });
  saveState();
  if (inputEl) inputEl.value = '';
  if (dateEl)  dateEl.value  = '';
  renderProjectTasks(projId);
  updateMetrics(); renderSummary();
}
window.addTask = addTask;

function cycleTaskStatus(projId, taskId) {
  const proj = state.projects.find(p => p.id === projId);
  if (!proj) return;
  const task = (proj.tasks || []).find(t => t.id === taskId);
  if (!task) return;
  task.status = TASK_NEXT[task.status] || 'pendente';
  saveState();
  renderProjectTasks(projId); updateMetrics(); renderSummary();
}
window.cycleTaskStatus = cycleTaskStatus;

function deleteTask(projId, taskId) {
  const proj = state.projects.find(p => p.id === projId);
  if (!proj) return;
  proj.tasks = (proj.tasks || []).filter(t => t.id !== taskId);
  saveState();
  renderProjectTasks(projId); updateMetrics(); renderSummary();
}
window.deleteTask = deleteTask;

// ── Hoje ─────────────────────────────────────────────────────────
function renderHoje() {
  const list = document.getElementById('hoje-list');
  if (!list) return;

  const BY_STAT = { fazendo: 0, pendente: 1 };
  const BY_PRIO = { alta: 0, media: 1, baixa: 2 };

  const allOpen = state.projects.flatMap(p =>
    (p.tasks || [])
      .filter(t => t.status !== 'feita')
      .map(t => ({ ...t, projNome: p.nome, projId: p.id, projColor: PRIO_COLOR[p.prio] }))
  ).sort((a, b) => {
    const sd = (BY_STAT[a.status] ?? 2) - (BY_STAT[b.status] ?? 2);
    return sd !== 0 ? sd : BY_PRIO[a.prio] - BY_PRIO[b.prio];
  });

  if (!allOpen.length) {
    list.innerHTML = '<p class="empty-msg">Nenhuma tarefa aberta. Excelente!</p>';
    return;
  }

  let lastProj = null;
  list.innerHTML = allOpen.map(t => {
    const projHeader = t.projNome !== lastProj ? `
      <div class="hoje-group-header">
        <span class="hoje-group-dot" style="background:${t.projColor}"></span>
        <span>${t.projNome}</span>
      </div>` : '';
    lastProj = t.projNome;
    const iconColor = t.status === 'fazendo' ? 'var(--accent)' : 'var(--text-muted)';
    return `
      ${projHeader}
      <div class="hoje-task ${t.status === 'fazendo' ? 'hoje-active' : ''}">
        <button
          class="task-icon-btn"
          onclick="cycleFromHoje(${t.projId}, ${t.id})"
          title="${TASK_TITLE[t.status]}"
          style="color:${iconColor}"
        >${TASK_ICON[t.status]}</button>
        <span class="task-text">${t.titulo}</span>
        <span class="prio-dot" style="background:${PRIO_COLOR[t.prio]}"></span>
      </div>`;
  }).join('');
}

function cycleFromHoje(projId, taskId) {
  const proj = state.projects.find(p => p.id === projId);
  if (!proj) return;
  const task = (proj.tasks || []).find(t => t.id === taskId);
  if (!task) return;
  task.status = TASK_NEXT[task.status] || 'pendente';
  saveState();
  renderHoje(); updateMetrics(); renderSummary(); renderProjectTasks(projId);
}
window.cycleFromHoje = cycleFromHoje;

// ── Rotina ───────────────────────────────────────────────────────
function renderRotina() {
  const grid   = document.getElementById('rotina-grid');
  const ativos = state.projects
    .filter(p => p.prio !== 'pausada')
    .sort((a, b) => PRIO_WEIGHT[b.prio] - PRIO_WEIGHT[a.prio]);

  if (!ativos.length) {
    grid.innerHTML = '<p class="empty-msg">Adicione projetos ativos para gerar a rotina.</p>';
    return;
  }

  const pool = [];
  ativos.forEach(p => { for (let i = 0; i < PRIO_WEIGHT[p.prio]; i++) pool.push(p); });

  let html = '<div class="rotina-table">';
  DIAS.forEach((dia, di) => {
    html += `<div class="rotina-row"><div class="rotina-dia">${dia}</div>`;
    for (let s = 0; s < 3; s++) {
      const isSex = dia === 'Sex';
      if (isSex && s === 2) {
        html += `<div class="rotina-slot r-revisao">Revisão semanal</div>`;
      } else if (isSex && s === 1) {
        html += `<div class="rotina-slot r-buffer">buffer</div>`;
      } else {
        const p     = pool[(di * 3 + s) % pool.length];
        const color = PRIO_COLOR[p.prio];
        const bg    = PRIO_BG[p.prio];
        html += `<div class="rotina-slot" style="background:${bg};color:${color}">${p.nome}</div>`;
      }
    }
    html += '</div>';
  });
  grid.innerHTML = html + '</div>';
}

// ── Init ─────────────────────────────────────────────────────────
renderProjects();
</script>

